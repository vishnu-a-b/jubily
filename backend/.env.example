# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/event-registration?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters-long
JWT_EXPIRY=8h

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS Configuration (optional, for production only)
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Users (Format: username:hashedPassword:role)
# Generate hashes by running: npm run hash-password
USER_1=operator1:$2b$10$HASH_HERE:user
USER_2=operator2:$2b$10$HASH_HERE:user
USER_3=operator3:$2b$10$HASH_HERE:user
USER_4=operator4:$2b$10$HASH_HERE:user
USER_5=operator5:$2b$10$HASH_HERE:user
USER_6=operator6:$2b$10$HASH_HERE:user
USER_7=admin:$2b$10$HASH_HERE:admin
